<div class="simple-shop-craft-5e chat-card craft-card">
    <section class="card-header description">
        <header class="summary">
            <img class="gold-icon" src="{{ targetImg }}" alt="{{ targetName }}">
            <div class="name-stacked">
                <span class="title">{{ targetName }}</span>
                <span class="subtitle">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftCard.Crafter" }}: {{ actorName }}</span>
            </div>
        </header>
    </section>

    {{#if materialLines.length}}
    <div class="card-tray materials-tray collapsible">
        <label class="roboto-upper">
            <i class="fa-solid fa-mortar-pestle" inert></i>
            <span>{{ localize "DND5E.Materials" }} ({{ materialLines.length }})</span>
            <i class="fa-solid fa-caret-down" inert></i>
        </label>
        <div class="collapsible-content">
            <div class="wrapper">
                <ul class="targets unlist">
                    {{#each materialLines}}
                    <li class="target">
                        <img class="gold-icon" src="{{ this.img }}" alt="{{ this.name }}">
                        <div class="name-stacked">
                            <span class="title">{{ this.name }}</span>
                        </div>
                    </li>
                    {{/each}}
                </ul>
            </div>
        </div>
    </div>
    {{/if}}

    {{#if goldParts.length}}
    <hr>
    <div class="card-tray">
        <ul class="targets unlist">
            <li class="target">
                <div class="name-stacked">
                    <span class="title">{{ localize "SIMPLE_SHOP_CRAFT_5E.GoldFilled" }}</span>
                </div>
                {{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=goldParts }}
            </li>
        </ul>
    </div>
    {{/if}}

    <p class="supplement">{{ statusLabel }}</p>

    {{#if pending}}
    <div class="card-buttons">
        <button type="button" data-action="acceptCraft" data-visibility="gm">
            <i class="fas fa-check" inert></i> <span>{{ localize "SIMPLE_SHOP_CRAFT_5E.Accept" }}</span>
        </button>
        <button type="button" data-action="rejectCraft" data-visibility="gm">
            <i class="fas fa-xmark" inert></i> <span>{{ localize "SIMPLE_SHOP_CRAFT_5E.Reject" }}</span>
        </button>
    </div>
    {{/if}}
</div>
