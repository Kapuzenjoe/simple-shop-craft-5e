<div class="simple-shop-craft-5e chat-card purchase-card">
    <header class="card-header description">
        <div class="summary">
            <img class="gold-icon" src="{{ shopImg }}" alt="{{ shopName }}">
            <div class="name-stacked">
                <span class="title">{{ shopName }}</span>
                <span class="subtitle">{{ localize "SIMPLE_SHOP_CRAFT_5E.PurchaseCard.Buyer" }}: {{ actorName }}</span>
            </div>
        </div>
    </header>

    {{#if buyLines.length}}
    <div class="card-tray collapsible{{#unless pending}} collapsed{{/unless}}">
        <label class="roboto-upper">
            <i class="fa-solid fa-basket-shopping"></i>
            <span>{{ localize "SIMPLE_SHOP_CRAFT_5E.PurchaseCard.Buying" }} ({{ buyLines.length }})</span>
            <i class="fa-solid fa-caret-down"></i>
        </label>
        <div class="collapsible-content">
            <div class="wrapper">
                <ol class="targets unlist">
                    {{#each buyLines}}
                    <li class="target">
                        <img class="gold-icon" src="{{ this.img }}" alt="{{ this.name }}">
                        <div class="name-stacked">
                            <span class="title">{{ this.name }} <span class="bundle-size">×{{ this.quantity }}</span></span>
                        </div>
                        {{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=this.subtotal }}
                    </li>
                    {{/each}}
                </ol>
            </div>
        </div>
    </div>
    {{/if}}

    {{#if sellLines.length}}
    <div class="card-tray collapsible{{#unless pending}} collapsed{{/unless}}">
        <label class="roboto-upper">
            <i class="fa-solid fa-hand-holding-dollar"></i>
            <span>{{ localize "SIMPLE_SHOP_CRAFT_5E.PurchaseCard.Selling" }} ({{ sellLines.length }})</span>
            <i class="fa-solid fa-caret-down"></i>
        </label>
        <div class="collapsible-content">
            <div class="wrapper">
                <ol class="targets unlist">
                    {{#each sellLines}}
                    <li class="target">
                        <img class="gold-icon" src="{{ this.img }}" alt="{{ this.name }}">
                        <div class="name-stacked">
                            <span class="title">{{ this.name }} <span class="bundle-size">×{{ this.quantity }}</span></span>
                        </div>
                        {{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=this.subtotal }}
                    </li>
                    {{/each}}
                </ol>
            </div>
        </div>
    </div>
    {{/if}}

    <div class="cart-total">
        <span class="label roboto-upper">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.Total" }}</span>
        {{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=total }}
    </div>

    <p class="status-line">{{ statusLabel }}</p>

    {{#if pending}}
    <div class="card-buttons">
        <button type="button" data-action="acceptPurchase" data-visibility="gm">
            <i class="fas fa-check" inert></i> <span>{{ localize "SIMPLE_SHOP_CRAFT_5E.PurchaseCard.Accept" }}</span>
        </button>
        <button type="button" data-action="rejectPurchase" data-visibility="gm">
            <i class="fas fa-xmark" inert></i> <span>{{ localize "SIMPLE_SHOP_CRAFT_5E.PurchaseCard.Reject" }}</span>
        </button>
    </div>
    {{/if}}
</div>
