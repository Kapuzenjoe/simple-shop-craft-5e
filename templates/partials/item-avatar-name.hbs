{{ dnd5e-icon img alt=name classes="item-image gold-icon" }}
<div class="name name-stacked">
    <span class="title">
        {{ name }}
        {{#if bundleSize}}<span class="sign">&times;</span>{{ bundleSize }}{{/if}}
    </span>
    {{#if subtitle}}<span class="subtitle">{{ subtitle }}</span>{{/if}}
</div>
