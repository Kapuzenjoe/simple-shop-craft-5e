<div class="mod-item" data-tooltip="{{ localize hint }}">
    <i class="{{ icon }}" inert></i>
    {{#if editable}}
    <input type="number" name="{{ name }}" value="{{ value }}" min="-100" max="1000" step="1">
    {{else}}
    <span class="value">{{ value }}</span>
    {{/if}}
    <span class="unit">%</span>
</div>
