<section class="items-list">
    {{#each sections}}
    <div class="items-section card" data-type="{{ this.type }}">
        <div class="items-header header">
            <h3 class="item-name">{{ localize this.label }}</h3>
            {{#each this.columns}}
            <div class="item-header item-{{ this.id }}">{{#if this.label}}{{ localize this.label }}{{/if}}</div>
            {{/each}}
        </div>
        <ol class="item-list unlist">
            {{#each this.rows}}
            {{> (lookup this "template") this }}
            {{/each}}
        </ol>
    </div>
    {{/each}}
    {{#unless hasRows}}
    <p class="hint">{{{ localize emptyLabel }}}</p>
    {{/unless}}
</section>
