<div class="cart-content">
    {{#if lines.length}}
    <div class="card-tray">
        <label class="roboto-upper"><i class="fas fa-cart-shopping" inert></i><span>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.Buying" }}</span></label>
        <ol class="targets unlist">
            {{#each lines}}
            <li class="target">
                <img class="gold-icon" src="{{ this.item.img }}" alt="{{ this.item.name }}">
                <div class="name-stacked">
                    <span class="title">{{ this.item.name }} <span class="bundle-size">×{{ this.cartQuantity }}</span></span>
                </div>
                {{> "modules/simple-shop-craft-5e/templates/partials/currency-amount.hbs" parts=this.subtotal }}
            </li>
            {{/each}}
        </ol>
    </div>
    {{/if}}

    {{#if sellLines.length}}
    <div class="card-tray">
        <label class="roboto-upper"><i class="fas fa-hand-holding-dollar" inert></i><span>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.Selling" }}</span></label>
        <ol class="targets unlist">
            {{#each sellLines}}
            <li class="target">
                <img class="gold-icon" src="{{ this.item.img }}" alt="{{ this.item.name }}">
                <div class="name-stacked">
                    <span class="title">{{ this.item.name }} <span class="bundle-size">×{{ this.sellQuantity }}</span></span>
                </div>
                {{> "modules/simple-shop-craft-5e/templates/partials/currency-amount.hbs" parts=this.subtotal }}
            </li>
            {{/each}}
        </ol>
    </div>
    {{/if}}

    {{#unless hasLines}}
    <p>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.Empty" }}</p>
    {{/unless}}

    <div class="cart-total">
        <span class="label roboto-upper">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.Total" }}</span>
        {{> "modules/simple-shop-craft-5e/templates/partials/currency-amount.hbs" parts=total.parts }}
    </div>

    {{#if actor}}
    <div class="cart-balance{{#if balance.insufficient}} insufficient{{/if}}">
        <span class="label roboto-upper">{{ actor.name }} — {{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.Balance" }}</span>
        {{> "modules/simple-shop-craft-5e/templates/partials/currency-amount.hbs" parts=balance.before }}
        {{#if hasLines}}
        <span class="after">
            (
            {{#if balance.insufficient}}
            {{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.InsufficientFunds" }}
            {{else}}
            {{> "modules/simple-shop-craft-5e/templates/partials/currency-amount.hbs" parts=balance.after }}
            {{/if}}
            )
        </span>
        {{/if}}
    </div>
    {{else}}
    <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.NoActor" }}</p>
    {{/if}}

    {{#if noActiveGM}}
    <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.NoActiveGM" }}</p>
    {{/if}}

    <button type="button" class="confirm-button" data-action="confirm" {{#if confirmDisabled}}disabled{{/if}}>
        {{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.Confirm" }}
    </button>
</div>
