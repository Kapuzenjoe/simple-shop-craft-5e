<div class="owner-sidebar">
    <div class="owner-card card">
        <div class="header">
            <h3>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Owner" }}</h3>
        </div>
        <div class="owner-content">
            <div class="mod-row owner-mods">
                <div class="tab{{#if tabs.buy.active}} active{{/if}}" data-group="primary" data-tab="buy">
                    {{> "modules/simple-shop-craft-5e/templates/partials/mod-item.hbs"
                        icon="fas fa-tag" hint="SIMPLE_SHOP_CRAFT_5E.ShopEditor.BuyModifierHint"
                        name="buyModifier" value=shop.buyModifier editable=false}}
                </div>
                <div class="tab{{#if tabs.sell.active}} active{{/if}}" data-group="primary" data-tab="sell">
                    {{> "modules/simple-shop-craft-5e/templates/partials/mod-item.hbs"
                        icon="fas fa-coins" hint="SIMPLE_SHOP_CRAFT_5E.ShopEditor.SellModifierHint"
                        name="sellModifier" value=shop.sellModifier editable=false}}
                </div>
                <div class="mod-item cap-display" data-tooltip="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.GoldPool' }}">
                    <i class="fas fa-sack-dollar" inert></i>
                    {{#if goldPoolDisplay}}
                    {{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=goldPoolDisplay }}
                    {{else}}
                    <i class="fas fa-infinity" inert></i>
                    {{/if}}
                </div>
                {{#if editable}}
                <div class="mod-item clickable" data-action="resetShop" role="button"
                     data-tooltip="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.ResetRestock' }}">
                    <i class="fa-solid fa-rotate-left" inert></i>
                </div>
                {{/if}}
            </div>
            <div class="owner-row">
                {{#if npc}}
                <div class="npc-portrait clickable" data-action="openNpcSheet"
                     data-tooltip="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.OpenNpcSheet' }}">
                    <img class="item-image gold-icon" style="--gold-icon-size: 120px;" src="{{ npcImg }}" alt="{{ npc.name }}">
                </div>
                <div class="npc-name clickable" data-action="openNpcSheet">
                    <span class="value">{{ npc.name }}</span>
                </div>
                {{/if}}
            </div>
            {{#if npc}}
            <div class="description-block">
                <h3 class="icon"><i class="fas fa-book-open" inert></i><span class="roboto-upper">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.OwnerDescription" }}</span></h3>
                <p class="npc-bio">{{{ npc.system.details.biography.public }}}</p>
            </div>
            {{/if}}
        </div>
    </div>
</div>
