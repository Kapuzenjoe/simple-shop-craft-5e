<li class="item{{#if suppressed}} suppressed{{/if}}" data-id="{{ key }}" data-key="{{ key }}" data-name="{{ itemName }}" data-price="{{ priceCP }}"
    {{#if suppressed}}{{#unless @root.editable}}hidden{{/unless}}{{/if}}>
    <div class="item-row">
        <div class="item-detail item-cart">
            <a class="adjustment-button" data-action="adjustCartQuantity" data-key="{{ key }}" data-delta="-1"
               aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.DecreaseQuantity' }}">
                <i class="fa-solid fa-minus" inert></i>
            </a>
            <span>{{ cartQuantity }}</span>
            <a class="adjustment-button" data-action="adjustCartQuantity" data-key="{{ key }}" data-delta="+1"
               aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.IncreaseQuantity' }}">
                <i class="fa-solid fa-plus" inert></i>
            </a>
        </div>
        <div class="item-name item-tooltip rollable" data-action="openItemSheet" data-key="{{ key }}"
             {{#unless entry.generated}}data-uuid="{{ item.uuid }}"{{/unless}}
             role="button" aria-label="{{ itemName }}">
            {{> "modules/simple-shop-craft-5e/templates/shared/item-avatar-name.hbs"
                img=itemImg name=itemName bundleSize=bundleSize }}
            {{#if entry.hireling.actorUuid}}
            <i class="fa-solid fa-link linked-actor-icon" data-action="openLinkedActor" data-key="{{ key }}"
               data-tooltip="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.OpenLinkedActor' }}"></i>
            {{/if}}
            {{#if suppressed}}
            {{#if @root.editable}}
            <i class="fa-solid fa-triangle-exclamation {{#if item}}warning{{else}}error{{/if}}" data-tooltip="{{ suppressReason }}"></i>
            {{/if}}
            {{/if}}
            {{#if (and @root.editable identifierWarning)}}
            <i class="fa-solid fa-triangle-exclamation error" data-tooltip="{{ identifierWarning }}"></i>
            {{/if}}
            {{#if riderItemsInfo}}
            <i class="fa-solid fa-circle-info" data-tooltip="{{ riderItemsInfo }}"></i>
            {{/if}}
        </div>
        <div class="item-detail item-discount"
             data-tooltip="{{ discountTooltip }}"
             data-tooltip-class="property-attribution simple-shop-craft-5e"
             data-key="{{ key }}">
            <span class="value">{{ discountPercent }}</span>
            <span class="unit">%</span>
        </div>
        <div class="item-detail item-price">
            {{> "modules/simple-shop-craft-5e/templates/shared/currency-parts.hbs" parts=priceDisplay}}
        </div>
        {{#unless entry.isService}}
        {{> "modules/simple-shop-craft-5e/templates/shared/item-weight-cell.hbs" weight=weight }}
        {{/unless}}
        {{#if (and @root.editable stockTracked)}}
        <div class="item-detail item-uses">
            <input type="number" class="always-interactive" name="stock.{{ key }}" data-key="{{ key }}"
                   value="{{ stockCurrent }}" placeholder="0" min="0" step="1"
                   aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.StockCurrent' }}">
            {{#if (eq entry.restockMode "normal")}}
            <span class="separator">&sol;</span>
            <span class="max">{{ stockMax }}</span>
            {{/if}}
        </div>
        {{else}}
        <div class="item-detail item-quantity">
            <div class="stock-display">
                {{#if stockTracked}}
                <span class="value">
                    {{ stockCurrent }}{{#if (eq entry.restockMode "normal")}} / {{ stockMax }}{{/if}}
                </span>
                {{else}}
                <i class="fas fa-infinity" inert></i>
                {{/if}}
            </div>
        </div>
        {{/if}}
        <div class="item-detail item-controls">
            {{#if (and @root.editable @root.isEditMode)}}
            <button type="button" class="unbutton config-button item-control item-action" data-action="editItem"
                    data-key="{{ key }}" data-tooltip aria-label="{{ localize 'DND5E.ItemEdit' }}">
                <i class="fa-solid fa-pen-to-square" inert></i>
            </button>
            <button type="button" class="unbutton config-button item-control item-action" data-action="deleteItem"
                    data-key="{{ key }}" data-tooltip aria-label="{{ localize 'DND5E.ItemDelete' }}">
                <i class="fa-solid fa-trash" inert></i>
            </button>
            {{/if}}
            {{#if @root.editable}}
            <button type="button" class="unbutton config-button item-control always-interactive" data-context-menu
                    aria-label="{{ localize 'DND5E.AdditionalControls' }}">
                <i class="fa-solid fa-ellipsis-vertical" inert></i>
            </button>
            {{/if}}
        </div>
    </div>
</li>
