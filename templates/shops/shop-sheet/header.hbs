<header class="sheet-header">
    {{#if shopClosed}}
    <p class="hint warning">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.ShopClosedWarning" }}</p>
    {{/if}}
    <div class="header-top">
        <fieldset class="shop-summary">
            <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.Shop" }}</legend>
            <div class="shop-summary-body">
                <img class="document-image" src="{{ shop.displayImg }}" alt="{{ shop.name }}">
                <div class="shop-summary-info card">
                    <div class="info">
                        {{#if isGM}}
                        <div>
                            <span class="label">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.SettlementCap" }}</span>
                            {{#if settlementCapDisplay}}
                            <span class="value">
                            {{> "modules/simple-shop-craft-5e/templates/shared/currency-parts.hbs" parts=settlementCapDisplay}}
                            </span>
                            {{else}}
                            <span class="value">∞</span>
                            {{/if}}
                        </div>
                        {{/if}}
                        <div>
                            <span class="label">{{ localize "SIMPLE_SHOP_CRAFT_5E.Owner" }}</span>
                            <span class="value">
                                {{#with shop.owner as |owner|}}
                                {{#if owner.actor}}
                                <a class="content-link" draggable="true" data-link
                                   data-uuid="{{ @root.shop.npc }}" data-type="Actor">{{ owner.name }}</a>
                                {{else}}
                                {{#if (and owner.broken @root.isGM)}}
                                <i class="fa-solid fa-triangle-exclamation warning"
                                   data-tooltip="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.OwnerNotFound' }}"></i>
                                {{/if}}
                                {{ owner.name }}
                                {{/if}}
                                {{else}}—{{/with}}
                            </span>
                        </div>
                        <div>
                            <span class="label">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Tabs.Buy" }}</span>
                            <span class="value">{{ shop.buyModifier }}%</span>
                        </div>
                        <div>
                            <span class="label">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Tabs.Sell" }}</span>
                            <span class="value">{{ shop.sellModifier }}%</span>
                        </div>
                    </div>
                    <div class="info">
                        {{#if isGM}}
                        <div>
                            <span class="label">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GoldPool" }}</span>
                            <section class="currency">
                                {{#if shop.goldPool.sellDisabled}}
                                <span class="value">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.PurchaseOnlyShop" }}</span>
                                {{else}}
                                {{#if goldPoolDisplay}}
                                {{> "modules/simple-shop-craft-5e/templates/shared/currency-inputs.hbs"
                                    rows=goldPoolDisplay disabled=(not isEditMode)}}
                                {{else}}
                                <i class="fas fa-infinity" inert></i>
                                {{/if}}
                                {{/if}}
                                {{#if editable}}
                                <button type="button" class="item-action unbutton always-interactive" data-action="resetShop" data-tooltip
                                        aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.ResetRestock' }}">
                                    <i class="fa-solid fa-rotate-left" inert></i>
                                </button>
                                {{/if}}
                            </section>
                        </div>
                        {{/if}}
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset class="player-area">
            <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Player" }}</legend>
            <select name="selectedActor" class="uninput always-interactive" data-tooltip="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.ActingAs' }}">
                {{#each actorOptions}}
                <option value="{{ this.value }}" {{#if this.selected}}selected{{/if}}>{{ this.label }}</option>
                {{/each}}
            </select>
            <div class="player-area-actions">
                {{#if actor.system.skills}}
                <button type="button" class="gold-button always-interactive" data-action="haggle" data-tooltip
                        aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.Haggling' }}">
                    <i class="fa-solid fa-handshake" inert></i>
                </button>
                {{/if}}
                {{#if isGM}}
                <button type="button" class="gold-button always-interactive" data-action="editPlayers" data-tooltip
                        aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.EditPlayers' }}">
                    <i class="fa-solid fa-users" inert></i>
                </button>
                {{/if}}
            </div>
        </fieldset>
    </div>
</header>
