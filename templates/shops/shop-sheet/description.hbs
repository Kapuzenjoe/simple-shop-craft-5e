<section class="tab {{ tab.cssClass }}" data-tab="description" data-group="{{ tab.group }}">
    {{#if closedWeekdaysDisplay}}
    <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.ClosedWeekdays" }}: {{ closedWeekdaysDisplay }}</p>
    {{/if}}
    {{#if closedFestivalsDisplay}}
    <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.ClosedFestivals" }}: {{ closedFestivalsDisplay }}</p>
    {{/if}}
    {{#if isGM}}
    <prose-mirror name="description" value="{{ shop.description }}" class="always-interactive" toggled>{{{ enrichedDescription }}}</prose-mirror>
    {{else}}
    <div class="editor">
        <div class="editor-content">{{{ enrichedDescription }}}</div>
    </div>
    {{/if}}
</section>
