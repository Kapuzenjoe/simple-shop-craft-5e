<section class="tab active generate-item-content">
    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemType" }}</legend>
        {{> "dnd5e.fieldlist" typeFields }}
    </fieldset>

    {{#each typeFieldsets}}
    <fieldset>
        <legend>{{ this.label }}</legend>
        {{> "dnd5e.fieldlist" this.fields }}
    </fieldset>
    {{/each}}

    {{#if spellFieldset}}
    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemSpellFilter" }}</legend>
        {{> "dnd5e.fieldlist" spellFieldset.fields }}
    </fieldset>
    {{/if}}

    <fieldset>
        <legend>{{ localize "DND5E.Rarity" }}</legend>
        {{> "dnd5e.fieldlist" globalFields }}
    </fieldset>

    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemCount" }}</legend>
        <div class="form-group">
            <label>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemCount" }}</label>
            <div class="form-fields">
                <range-picker name="count" value="{{ count }}" min="1" max="10" step="1"></range-picker>
            </div>
        </div>
    </fieldset>
</section>
