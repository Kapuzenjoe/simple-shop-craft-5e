<section class="generate-item-preview">
    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemPool" }}</legend>
        {{#if pool}}
        <p class="pool-total">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemPoolTotal" count=pool.total }}</p>
        <ul class="pool-rarities unlist">
            {{#each pool.rarities}}
            <li>
                <span class="label">{{ label }}</span>
                <div class="meter progress meter-sm uses" role="meter" aria-valuemin="0" aria-valuemax="100"
                     aria-valuenow="{{ percent }}" style="--bar-percentage: {{ percent }}%;"></div>
                <span class="count">{{ count }}</span>
                <span class="capped">{{#if capped}}<i class="fa-solid fa-ban" inert></i> {{ capped }}{{/if}}</span>
            </li>
            {{/each}}
        </ul>
        {{#if pool.capped}}
        <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemPoolCapped" count=pool.capped }}</p>
        {{/if}}
        {{#unless pool.total}}
        <p class="hint warning">
            {{ localize (ifThen pool.capped "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemPoolEmptyCapped" "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemPoolEmpty") }}
        </p>
        {{/unless}}
        {{else}}
        <p class="hint">
            <i class="fa-solid fa-spinner fa-spin" inert></i>
            {{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemPoolCalculating" }}
        </p>
        {{/if}}
    </fieldset>

    {{#if pool.chances.length}}
    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.GenerateItemPoolChance" }}</legend>
        <ul class="pool-chances unlist">
            {{#each pool.chances}}
            <li>
                <span class="label">{{ label }}</span>
                <div class="meter progress meter-sm uses" role="meter" aria-valuemin="0" aria-valuemax="100"
                     aria-valuenow="{{ percent }}" style="--bar-percentage: {{ percent }}%;"></div>
                <span class="count">{{ percent }}%</span>
            </li>
            {{/each}}
        </ul>
    </fieldset>
    {{/if}}
</section>
