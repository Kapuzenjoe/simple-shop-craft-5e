<section>
    {{#each rows}}
    <fieldset>
        <div class="form-group"><label>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Template" }}</label></div>
        <div class="value-row">
            {{> "modules/simple-shop-craft-5e/templates/partials/item-avatar-name.hbs" img=itemImg name=itemName }}
        </div>
        <hr>
        {{#if (eq kind "spellScroll")}}
        <div class="form-group"><label>{{ localize "TYPES.Item.spell" }}</label></div>
        <div class="pill-lg {{#unless pick}}empty{{/unless}}" data-action="pickSpell" data-row="{{ index }}">
            {{#if pick}}
            <img class="gold-icon" src="{{ pick.img }}" alt="{{ pick.name }}">
            <div class="name-stacked"><div class="title">{{ pick.name }}</div></div>
            <button type="button" class="unbutton control-button item-control" data-action="pickSpell"
                    data-row="{{ index }}" data-tooltip
                    aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.PickSpell' }}">
                <i class="fa-solid fa-magnifying-glass" inert></i>
            </button>
            {{else}}
            {{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.PickSpell" }}
            {{/if}}
        </div>
        {{else}}
        {{#if hasMultipleProfiles}}
        <div class="form-group">
            <label>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.EnchantProfile" }}</label>
            <select name="profile-{{ index }}">
                {{#each profileOptions}}
                <option value="{{ value }}" {{#if (eq value ../profileIndex)}}selected{{/if}}>{{ label }}</option>
                {{/each}}
            </select>
        </div>
        {{/if}}
        {{#if baseItemOptions}}
        <div class="form-group">
            <label>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.BaseItem" }}</label>
            <select name="baseItem-{{ index }}">
                {{#each baseItemOptions}}
                <option value="{{ value }}">{{ label }}</option>
                {{/each}}
            </select>
        </div>
        {{else}}
        <div class="form-group"><label>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.BaseItem" }}</label></div>
        <div class="pill-lg {{#unless pick}}empty{{/unless}}" data-action="pickBaseItem" data-row="{{ index }}">
            {{#if pick}}
            <img class="gold-icon" src="{{ pick.img }}" alt="{{ pick.name }}">
            <div class="name-stacked"><div class="title">{{ pick.name }}</div></div>
            <button type="button" class="unbutton control-button item-control" data-action="pickBaseItem"
                    data-row="{{ index }}" data-tooltip
                    aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.PickBaseItem' }}">
                <i class="fa-solid fa-magnifying-glass" inert></i>
            </button>
            {{else}}
            {{ restrictionLabel }}
            {{/if}}
        </div>
        {{/if}}
        {{/if}}
        {{#if pick}}
        <div class="icon-picker-group">
            {{ formGroup ../imgField value=imgOverride placeholder=pick.img name=(concat "img-" index)
                         label="SIMPLE_SHOP_CRAFT_5E.ShopEditor.Icon" localize=true classes="full-width" }}
            <img class="icon-picker-preview" src="{{#if imgOverride}}{{ imgOverride }}{{else}}{{ pick.img }}{{/if}}" alt="">
        </div>
        {{ formField ../identifierField value=identifierOverride placeholder=identifierPreview
                     name=(concat "identifier-" index) label="DND5E.Identifier" localize=true }}
        {{/if}}
    </fieldset>
    {{/each}}
</section>
