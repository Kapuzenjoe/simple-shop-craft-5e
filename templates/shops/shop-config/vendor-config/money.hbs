<section class="tab {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.RestockMoney" }}</legend>
        {{> "dnd5e.fieldlist" moneyFields}}
        {{#if currencyRows}}
        <div class="form-group stacked">
            <label>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.RestockAmount" }}</label>
            <section class="currency">
                {{> "modules/simple-shop-craft-5e/templates/shared/currency-inputs.hbs" rows=currencyRows}}
            </section>
            <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.RestockAmountHint" }}</p>
        </div>
        {{/if}}
    </fieldset>
    {{#if typeFilter}}
    {{> "modules/simple-shop-craft-5e/templates/shared/type-filter.hbs"
        legend=(localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.SellTypes") typeFields=typeFilter.typeFields
        typeFieldsets=typeFilter.typeFieldsets }}
    {{/if}}
    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Stock" }}</legend>
        {{> "dnd5e.fieldlist" stockFields}}
    </fieldset>
    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.RestockDays" }}</legend>
        <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.RestockDaysHint" }}</p>
        {{#unless calendarModeActive}}
        <p class="note warn">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.AutoRestockNoCalendarHint" }}</p>
        {{/unless}}
        {{ formInput shopFields.restockWeekdays value=restockWeekdays options=restockWeekdayOptions classes="full-width" }}
    </fieldset>
</section>
