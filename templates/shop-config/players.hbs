<section class="tab {{#if tab.active}}active{{/if}}" data-group="primary" data-tab="players">
    <div class="items-section card">
        <div class="items-header header">
            <h3 class="item-name">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Player" }}</h3>
            <div class="item-header item-discount">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Tabs.Buy" }}</div>
            <div class="item-header item-discount">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Tabs.Sell" }}</div>
            <div class="item-header item-controls"></div>
        </div>
        <ol class="item-list unlist">
            {{#each playerDiscounts}}
            <li class="item">
                <div class="item-row">
                    <div class="item-name">
                        {{ dnd5e-icon this.actorImg alt=this.actorName classes="item-image gold-icon" }}
                        {{{ dnd5e-linkForUuid this.actorUuid renderBroken=true }}}
                        <input type="hidden" name="playerDiscounts.{{ this.index }}.actor" value="{{ this.actorUuid }}">
                    </div>
                    <div class="item-detail item-discount">
                        {{ numberInput this.buyModifier name=(concat "playerDiscounts." this.index ".buy")
                            class="uninput" placeholder="—" min=-100 max=1000 step=1 }}
                        <span class="unit">%</span>
                    </div>
                    <div class="item-detail item-discount">
                        {{ numberInput this.sellModifier name=(concat "playerDiscounts." this.index ".sell")
                            class="uninput" placeholder="—" min=-100 max=1000 step=1 }}
                        <span class="unit">%</span>
                    </div>
                    <div class="item-detail item-controls always-visible">
                        <button type="button" class="unbutton config-button item-control always-interactive"
                                data-action="removePlayerDiscount" data-index="{{ this.index }}" data-tooltip
                                aria-label="{{ localize 'DND5E.ItemDelete' }}">
                            <i class="fa-solid fa-trash" inert></i>
                        </button>
                    </div>
                </div>
            </li>
            {{else}}
            <p>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopConfig.Players.None" }}</p>
            {{/each}}
        </ol>
    </div>
    <document-tags name="newPlayerActors" type="Actor" class="hidden-tags drop-area"
                   data-drop-hint="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopConfig.Players.DropHint' }}"></document-tags>
</section>
