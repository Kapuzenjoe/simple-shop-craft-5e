<section class="tab {{#if tab.active}}active{{/if}}" data-group="primary" data-tab="identity">
    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopManager.Shops.Shop" }}</legend>
        {{ formField fields.name value=name rootId="identity" }}
        {{ formField fields.location value=location
            placeholder=(localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.LocationPlaceholder") rootId="identity" }}
        {{ formField fields.img value=img rootId="identity" }}
        <hr>
        <prose-mirror class="slim" name="description" value="{{ description }}" compact></prose-mirror>
    </fieldset>

    <fieldset>
        <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Owner" }}</legend>
        <ul class="separated-list single-item">
            <li>
                <document-tags name="npc" type="Actor" single value="{{ npcUuid }}"></document-tags>
            </li>
        </ul>
    </fieldset>
</section>
