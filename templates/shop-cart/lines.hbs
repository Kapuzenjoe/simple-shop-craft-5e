<section>
    {{~#if rows.length}}
    <fieldset class="card-tray">
        <legend><i class="{{ icon }}" inert></i> {{ localize label }}</legend>
        <ol class="targets unlist">
            {{#each rows}}
            <li class="target">
                <img class="gold-icon" src="{{ this.img }}" alt="{{ this.name }}">
                <div class="name-stacked">
                    <p class="title">{{ this.name }} <span class="bundle-size">×{{ this.quantity }}</span></p>
                </div>
                {{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=this.subtotal }}
            </li>
            {{/each}}
        </ol>
    </fieldset>
    {{/if~}}
</section>
