<div class="tab{{#if tab.active}} active{{/if}} inventory-element" data-group="primary" data-tab="buy">
    {{#each groups}}
    <div class="items-section card">
        <div class="items-header header">
            <div class="item-header item-cart">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.CartQuantity" }}</div>
            <h3 class="item-name">{{ this.label }}</h3>
            <div class="item-header item-discount">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.PriceModifier" }}</div>
            <div class="item-header item-price">{{ localize "DND5E.Price" }}</div>
            <div class="item-header item-weight">{{ localize "DND5E.Weight" }}</div>
            <div class="item-header item-quantity">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Stock" }}</div>
            <div class="item-header item-controls"></div>
        </div>
        <ol class="item-list unlist">
            {{#each this.items}}
            <li class="item{{#if this.suppressed}} suppressed{{/if}}"
                {{#if this.suppressed}}{{#unless @root.editable}}hidden{{/unless}}{{/if}}>
                <div class="item-row">
                    <div class="item-detail item-cart">
                        <a class="adjustment-button" data-action="adjustCartQty" data-key="{{ this.key }}" data-delta="-1"
                           aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.DecreaseQuantity' }}">
                            <i class="fa-solid fa-minus" inert></i>
                        </a>
                        <span>{{ this.cartQuantity }}</span>
                        <a class="adjustment-button" data-action="adjustCartQty" data-key="{{ this.key }}" data-delta="+1"
                           aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.IncreaseQuantity' }}">
                            <i class="fa-solid fa-plus" inert></i>
                        </a>
                    </div>
                    <div class="item-name item-tooltip clickable" data-uuid="{{ this.item.uuid }}"
                         data-action="openItemSheet" role="button" aria-label="{{ this.itemName }}">
                        {{> "modules/simple-shop-craft-5e/templates/partials/item-avatar-name.hbs"
                            img=this.itemImg name=this.itemName bundleSize=this.bundleSize }}
                        {{#if this.suppressed}}
                        {{#if @root.editable}}
                        <i class="fa-solid fa-triangle-exclamation suppress-warning" data-tooltip="{{ this.suppressReason }}"></i>
                        {{/if}}
                        {{/if}}
                    </div>
                    <div class="item-detail item-discount">
                        {{#if @root.editable}}
                        <input type="number" name="items.{{ this.key }}.discount"
                               value="{{ this.entry.discount }}" placeholder="{{ ../../shop.buyModifier }}"
                               min="-100" max="1000" step="1"
                               aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.PriceModifier' }}">
                        {{else}}
                        <span class="value">{{ this.discountPercent }}</span>
                        {{/if}}
                        <span class="unit">%</span>
                    </div>
                    <div class="item-detail item-price">
                        <div class="price-display{{#if @root.editable}} clickable{{/if}}"
                             {{#if @root.editable}}data-action="editPrice" role="button" data-tooltip
                             aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.PriceTooltip' }}"{{/if}}
                             data-key="{{ this.key }}">
                            {{#each this.priceDisplay.parts}}
                            <span class="value">{{ dnd5e-numberFormat this.value }}</span>
                            <i class="currency {{ this.denomination }}"
                               aria-label="{{ lookup (lookup @root.config.currencies this.denomination) 'label' }}"></i>
                            {{/each}}
                            {{#if this.priceDisplay.original}}
                            <span class="original">
                                ({{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=this.priceDisplay.original }})
                            </span>
                            {{/if}}
                        </div>
                    </div>
                    {{> "modules/simple-shop-craft-5e/templates/partials/item-weight-cell.hbs" weight=this.weight }}
                    <div class="item-detail item-quantity">
                        <div class="stock-display{{#if @root.editable}} clickable{{/if}}"
                             {{#if @root.editable}}data-action="editMaxStock" data-key="{{ this.key }}" role="button"
                             data-tooltip aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.StockTooltip' }}"{{/if}}>
                            {{#if this.stockTracked}}
                            <span class="value">
                                {{ this.entry.stock.current }}{{#unless this.entry.noRestock}} / {{ this.entry.stock.max }}{{/unless}}
                            </span>
                            {{else}}
                            <i class="fas fa-infinity" inert></i>
                            {{/if}}
                        </div>
                    </div>
                    <div class="item-detail item-controls">
                        {{#if @root.editable}}
                        <button type="button" class="unbutton config-button item-control item-action"
                                data-action="removeItem" data-key="{{ this.key }}"
                                data-tooltip aria-label="{{ localize 'DND5E.ItemDelete' }}">
                            <i class="fas fa-trash" inert></i>
                        </button>
                        {{/if}}
                    </div>
                </div>
            </li>
            {{/each}}
        </ol>
    </div>
    {{/each}}
    {{#unless groups.length}}
    <p>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.None" }}</p>
    {{/unless}}
</div>
