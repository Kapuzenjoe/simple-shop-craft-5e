<section class="tab active craft-start-content">

<fieldset>
    <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Player" }}</legend>
    <select name="selectedActor" class="uninput always-interactive">
        {{#each actorOptions}}
        <option value="{{ this.value }}" {{#if this.selected}}selected{{/if}}>{{ this.label }}</option>
        {{/each}}
    </select>
</fieldset>

{{#if noActor}}
<p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.NoActor" }}</p>
{{else if locked}}
<p class="hint warning">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopManager.Recipes.Locked" }}</p>
{{else}}

<fieldset class="card-tray">
    <legend>{{ displayName }}</legend>
    <ol class="value-list unlist">
        <li class="value-row">
            <img class="gold-icon" src="{{ targetItem.img }}" alt="{{ targetItem.name }}">
            <div class="name-stacked">
                <span class="title">
                    {{ targetItem.name }}
                    {{#if (gt recipe.targetQuantity 1)}}<span class="bundle-size">(&times;{{ recipe.targetQuantity }})</span>{{/if}}
                </span>
            </div>
        </li>
    </ol>
    {{#unless targetItem}}
    <p class="hint error">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.SuppressedNotFound" }}</p>
    {{/unless}}
    {{#if countField}}
    {{> "dnd5e.fieldlist" countField}}
    {{/if}}
</fieldset>

{{#if recipe.spellScroll}}
<fieldset class="card-tray">
    <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.Spell" }}</legend>
    {{#if spellField}}
    {{> "dnd5e.fieldlist" spellField}}
    {{else if noEligibleSpell}}
    <p class="hint warning">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.NoEligibleSpell" }}</p>
    {{else if chosenSpell}}
    <ol class="value-list unlist">
        <li class="value-row">
            <img class="gold-icon" src="{{ chosenSpell.img }}" alt="{{ chosenSpell.name }}">
            <div class="name-stacked"><span class="title">{{ chosenSpell.name }}</span></div>
            <button type="button" class="unbutton control-button" data-action="removeSpell" data-tooltip
                    aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.CraftStart.RemoveSpell' }}">
                <i class="fa-solid fa-xmark" inert></i>
            </button>
        </li>
    </ol>
    {{else}}
    <button type="button" data-action="chooseSpell">
        {{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.ChooseSpell" }}
    </button>
    {{/if}}
    {{> "dnd5e.fieldlist" spellValueFields}}
</fieldset>
{{/if}}

{{#if requirementGroups.length}}
<fieldset>
    <legend>{{ localize "DND5E.Requirements" }}</legend>
    <section class="items-list">
        {{#each requirementGroups}}
        <div class="items-section card">
            {{#if this.heading}}
            <div class="items-header header">
                <h3 class="item-name">{{ this.heading }}</h3>
            </div>
            {{/if}}
            <ul class="item-list unlist">
                {{#each this.entries}}
                <li class="item{{#if this.dimmed}} suppressed{{/if}}">
                    <div class="item-row">
                        <div class="item-name">
                            <i class="fa-solid fa-fw {{#if this.met}}fa-check success{{else}}fa-xmark failure{{/if}}" inert></i>
                            <div class="name name-stacked">
                                <span class="title">{{ this.label }}</span>
                                {{#if (or this.workshop this.notProficient this.notInInventory)}}
                                <span class="subtitle">
                                    {{#if this.workshop}}{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.Workshop" }}{{/if}}
                                    {{#if this.notProficient}}{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.NotProficient" }}{{/if}}
                                    {{#if (and this.notProficient this.notInInventory)}}&middot;{{/if}}
                                    {{#if this.notInInventory}}{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.NotInInventory" }}{{/if}}
                                </span>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </li>
                {{/each}}
            </ul>
        </div>
        {{#if this.atLeastOne}}
        <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.AtLeastOne" }}</p>
        {{/if}}
        {{#if this.workshopField}}
        {{> "dnd5e.fieldlist" this.workshopField}}
        {{/if}}
        {{/each}}
    </section>
</fieldset>
{{/if}}

<fieldset class="card-tray">
    <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.CraftingMaterials" }}</legend>
    {{> "modules/simple-shop-craft-5e/templates/shared/item-table.hbs" materialsTable}}

    {{#if allowFreeform}}
    <div class="drop-area" data-drop-area>
        <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.DropMaterialHint" }}</p>
    </div>
    {{/if}}
</fieldset>

{{#unless requiredAvailable}}
<p class="hint error">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.RequiredMissing" }}</p>
{{/unless}}

{{#unless recipe.ignoreCraftValue}}
<fieldset class="card-tray">
    <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.MaterialValue" }}</legend>
    {{#unless materialsMet}}
    <p class="hint error">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.ValueMissing" }}</p>
    {{/unless}}

    <p class="hint">
        {{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.Supplied" }}:
        {{> "modules/simple-shop-craft-5e/templates/shared/currency-parts.hbs" parts=suppliedParts }}
    </p>
    <p class="hint{{#unless materialsMet}} error{{/unless}}">
        {{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.Threshold" }}:
        {{> "modules/simple-shop-craft-5e/templates/shared/currency-parts.hbs" parts=thresholdParts }}
    </p>

    {{#if goldField}}
    {{> "dnd5e.fieldlist" goldField}}
    {{#if fillWithGold}}
    <p class="hint">
        {{ localize "SIMPLE_SHOP_CRAFT_5E.GoldFilled" }}:
        {{> "modules/simple-shop-craft-5e/templates/shared/currency-parts.hbs" parts=goldParts }}
    </p>
    {{#if goldInsufficient}}
    <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.InsufficientFunds" }}</p>
    {{/if}}
    {{/if}}
    {{/if}}
</fieldset>
{{/unless}}

{{/if}}
</section>
