<li class="item" data-id="{{ recipe._id }}" data-recipe-id="{{ recipe._id }}">
    <div class="item-row">
        <div class="item-name rollable" data-action="startCraft" role="button" data-recipe-id="{{ recipe._id }}">
            {{> "modules/simple-shop-craft-5e/templates/partials/item-avatar-name.hbs"
                img=recipe.img name=displayName }}
        </div>
        <div class="item-detail item-unlocked">{{ unlockedLabel }}</div>
        <div class="item-detail item-controls always-visible">
            {{#if @root.isGM}}
            <button type="button" class="unbutton config-button item-control item-action" data-action="editRecipe"
                    data-recipe-id="{{ recipe._id }}" data-tooltip aria-label="{{ localize 'DND5E.ItemEdit' }}">
                <i class="fa-solid fa-pen-to-square" inert></i>
            </button>
            <button type="button" class="unbutton config-button item-control always-interactive" data-context-menu
                    aria-label="{{ localize 'DND5E.AdditionalControls' }}">
                <i class="fa-solid fa-ellipsis-vertical" inert></i>
            </button>
            {{/if}}
        </div>
    </div>
</li>
