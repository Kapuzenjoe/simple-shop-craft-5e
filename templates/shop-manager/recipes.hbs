<section class="tab {{ tab.cssClass }}" data-tab="recipes" data-group="{{ tab.group }}">
    <search>
        <input type="search" class="item-search always-interactive"
               placeholder="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopManager.Recipes.SearchRecipes' }}">
        <button type="button" class="filter-control clear-control unbutton always-interactive" data-tooltip
                aria-label="{{ localize 'DND5E.FilterClear' }}">
            <i class="fa-solid fa-xmark" inert></i>
        </button>
        <label class="filter-control" data-tooltip="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.AllTypes' }}">
            <select class="item-type-filter always-interactive">
                <option value="">{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.AllTypes' }}</option>
                {{#each recipeTypes}}
                <option value="{{ this.type }}">{{ localize this.label }}</option>
                {{/each}}
            </select>
        </label>
        <button type="button" class="filter-control sort-control always-interactive" data-tooltip
                aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.SortByName' }}">
            <i class="fa-solid fa-arrow-down-a-z" inert></i>
        </button>
        <button type="button" class="filter-control group-control always-interactive" data-tooltip
                aria-label="{{ localize 'DND5E.FilterGroupCategory' }}">
            <i class="fa-solid fa-layer-group" inert></i>
        </button>
    </search>
    {{> "modules/simple-shop-craft-5e/templates/shared/item-table.hbs" recipeTable}}
    {{#if isGM}}
    <div class="window-content-actions">
        <button type="button" data-action="importRecipes" class="gold-button always-interactive" data-tooltip
                aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopManager.Recipes.Import' }}">
            <i class="fas fa-file-import" inert></i>
        </button>
        {{#if isModern}}
        <button type="button" data-action="importDefaultRecipes" class="gold-button always-interactive" data-tooltip
                aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopManager.Recipes.ImportDefaults' }}">
            <i class="fas fa-book-open" inert></i>
        </button>
        {{/if}}
        <button type="button" data-action="createRecipe" class="gold-button always-interactive" data-tooltip
                aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopManager.Recipes.Create' }}">
            <i class="fas fa-plus" inert></i>
        </button>
    </div>
    {{/if}}
</section>
