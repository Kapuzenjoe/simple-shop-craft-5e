<section class="tab {{ tab.cssClass }}" data-tab="shops" data-group="{{ tab.group }}">
    <search>
        <input type="search" class="item-search always-interactive"
               placeholder="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopManager.Shops.SearchShops' }}">
        <button type="button" class="filter-control sort-control always-interactive" data-tooltip
                aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.SortByName' }}">
            <i class="fa-solid fa-arrow-down-a-z" inert></i>
        </button>
    </search>
    {{> "modules/simple-shop-craft-5e/templates/partials/item-table.hbs" table}}
    {{#if isGM}}
    <button type="button" data-action="createShop" class="gold-button always-interactive create-child"
            data-tooltip
            aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopManager.Shops.Create' }}">
        <i class="fas fa-plus" inert></i>
    </button>
    {{/if}}
</section>
