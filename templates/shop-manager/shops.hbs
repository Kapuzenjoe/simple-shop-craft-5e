<section class="tab {{#if tab.active}}active{{/if}} inventory-element" data-group="primary" data-tab="shops">
    <div class="items-section card">
        <div class="items-header header">
            <h3 class="item-name">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopManager.Shops.Shop" }}</h3>
            <div class="item-header item-npc">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopManager.Shops.Owner" }}</div>
            <div class="item-header item-controls"></div>
        </div>
        <ol class="item-list unlist">
            {{#each shops}}
            <li class="item" data-id="{{ this.shop._id }}" data-shop-id="{{ this.shop._id }}">
                <div class="item-row">
                    <div class="item-name rollable" data-action="editShop" role="button" data-shop-id="{{ this.shop._id }}">
                        {{> "modules/simple-shop-craft-5e/templates/partials/item-avatar-name.hbs"
                            img=this.shop.img name=this.shop.name subtitle=this.subtitle }}
                    </div>
                    <div class="item-detail item-npc{{#unless this.npc}} empty{{/unless}}">
                        {{#if this.npc}}
                        <span class="title">{{ this.npc.name }}</span>
                        {{/if}}
                    </div>
                    <div class="item-detail item-controls always-visible">
                        {{#if ../isGM}}
                        <button type="button" class="unbutton config-button item-control item-action{{#if this.shop.active}} active{{/if}}"
                                data-action="toggleActive" data-shop-id="{{ this.shop._id }}"
                                data-tooltip
                                aria-label="{{ localize (concat 'SIMPLE_SHOP_CRAFT_5E.ShopManager.Shops.' (ifThen this.shop.active 'Deactivate' 'Activate')) }}">
                            <i class="fa-solid fa-toggle-{{ ifThen this.shop.active 'on' 'off' }}" inert></i>
                        </button>
                        <button type="button" class="unbutton config-button item-control always-interactive" data-context-menu
                                aria-label="{{ localize 'DND5E.AdditionalControls' }}">
                            <i class="fa-solid fa-ellipsis-vertical" inert></i>
                        </button>
                        {{/if}}
                    </div>
                </div>
            </li>
            {{else}}
            <p>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopManager.Shops.None" }}</p>
            {{/each}}
        </ol>
    </div>
    {{#if isGM}}
    <button type="button" data-action="createShop" class="gold-button always-interactive create-child"
            data-tooltip
            aria-label="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopManager.Shops.Create' }}">
        <i class="fas fa-plus" inert></i>
    </button>
    {{/if}}
</section>
