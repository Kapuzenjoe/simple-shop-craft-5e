<li class="item" data-id="{{ shop._id }}" data-shop-id="{{ shop._id }}" data-name="{{ shop.name }}">
    <div class="item-row">
        <div class="item-name rollable" data-action="editShop" role="button" data-shop-id="{{ shop._id }}">
            {{> "modules/simple-shop-craft-5e/templates/shared/item-avatar-name.hbs"
                img=shop.displayImg name=shop.name subtitle=subtitle }}
            {{#if sceneTooltip}}
            <i class="fa-solid fa-map scene-icon" data-tooltip="{{ sceneTooltip }}"
               data-tooltip-class="simple-shop-craft-5e stacked-tooltip"></i>
            {{/if}}
        </div>
        <div class="item-detail item-npc{{#unless shop.owner}} empty{{/unless}}">
            {{#with shop.owner as |owner|}}
            {{#if (and owner.broken @root.isGM)}}
            <i class="fa-solid fa-triangle-exclamation warning"
               data-tooltip="{{ localize 'SIMPLE_SHOP_CRAFT_5E.ShopEditor.OwnerNotFound' }}"></i>
            {{/if}}
            <span class="title">{{ owner.name }}</span>
            {{/with}}
        </div>
        <div class="item-detail item-openingHours">{{ openingHours }}</div>
        <div class="item-detail item-settlementCap">
            {{#if settlementCapDisplay}}
            {{> "modules/simple-shop-craft-5e/templates/shared/currency-parts.hbs" parts=settlementCapDisplay}}
            {{else}}
            ∞
            {{/if}}
        </div>
        <div class="item-detail item-active always-visible">
            {{#if @root.isGM}}
            <button type="button" class="unbutton config-button item-control item-action{{#if shop.active}} active{{/if}}"
                    data-action="toggleActive" data-shop-id="{{ shop._id }}"
                    data-tooltip
                    aria-label="{{ localize (concat 'SIMPLE_SHOP_CRAFT_5E.ShopManager.Shops.' (ifThen shop.active 'Deactivate' 'Activate')) }}">
                <i class="fa-solid fa-toggle-{{ ifThen shop.active 'on' 'off' }}" inert></i>
            </button>
            {{/if}}
        </div>
        <div class="item-detail item-controls always-visible">
            {{#if @root.isGM}}
            <button type="button" class="unbutton config-button item-control always-interactive" data-context-menu
                    aria-label="{{ localize 'DND5E.AdditionalControls' }}">
                <i class="fa-solid fa-ellipsis-vertical" inert></i>
            </button>
            {{/if}}
        </div>
    </div>
</li>
