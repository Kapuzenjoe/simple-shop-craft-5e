<section class="tab active craft-start-content">

<fieldset>
    <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopEditor.Player" }}</legend>
    <select name="selectedActor" class="uninput always-interactive">
        {{#each actorOptions}}
        <option value="{{ this.value }}" {{#if this.selected}}selected{{/if}}>{{ this.label }}</option>
        {{/each}}
    </select>
</fieldset>

{{#if noActor}}
<p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.NoActor" }}</p>
{{else}}

<fieldset class="card-tray">
    <legend>{{ displayName }}</legend>
    <ol class="targets unlist">
        <li class="target">
            <img class="gold-icon" src="{{ targetItem.img }}" alt="{{ targetItem.name }}">
            <div class="name-stacked">
                <span class="title">
                    {{ targetItem.name }}
                    {{#if (gt recipe.targetQuantity 1)}}<span class="bundle-size">(&times;{{ recipe.targetQuantity }})</span>{{/if}}
                </span>
            </div>
        </li>
    </ol>
</fieldset>

{{#if chosenToolKey}}
<fieldset>
    <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.Tool" }}</legend>
    {{#if toolField}}
    {{> "dnd5e.fieldlist" toolField}}
    {{else}}
    <p>{{ toolLabel }}</p>
    {{/if}}
    {{#if skillProficient}}
    <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.SkillProficient" }}</p>
    {{else}}
    {{#unless toolProficient}}
    <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.NotProficient" }}</p>
    {{/unless}}
    {{#unless toolOwned}}
    <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.ToolMissing" }}</p>
    {{/unless}}
    {{/if}}
    {{#if workshopField}}
    {{> "dnd5e.fieldlist" workshopField}}
    {{/if}}
</fieldset>
{{/if}}

<fieldset class="card-tray">
    <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.CraftingMaterials" }}</legend>
    {{> "modules/simple-shop-craft-5e/templates/partials/item-table.hbs" materialsTable}}

    {{#if allowFreeform}}
    <div class="drop-area" data-drop-area>
        <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.DropMaterialHint" }}</p>
    </div>
    {{/if}}
</fieldset>

{{#unless requiredAvailable}}
<p class="hint warning">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.RequiredMissing" }}</p>
{{/unless}}

{{#unless recipe.ignoreCraftValue}}
<fieldset class="card-tray">
    <legend>{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.MaterialValue" }}</legend>
    {{#unless materialsMet}}
    <p class="hint warning">{{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.ValueMissing" }}</p>
    {{/unless}}

    <p class="hint">
        {{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.Supplied" }}:
        {{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=suppliedParts }}
    </p>
    <p class="hint{{#unless materialsMet}} warning{{/unless}}">
        {{ localize "SIMPLE_SHOP_CRAFT_5E.CraftStart.Threshold" }}:
        {{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=thresholdParts }}
    </p>

    {{#if goldField}}
    {{> "dnd5e.fieldlist" goldField}}
    {{#if fillWithGold}}
    <p class="hint">
        {{ localize "SIMPLE_SHOP_CRAFT_5E.GoldFilled" }}:
        {{> "modules/simple-shop-craft-5e/templates/partials/currency-parts.hbs" parts=goldParts }}
    </p>
    {{#if goldInsufficient}}
    <p class="hint">{{ localize "SIMPLE_SHOP_CRAFT_5E.ShopCart.InsufficientFunds" }}</p>
    {{/if}}
    {{/if}}
    {{/if}}
</fieldset>
{{/unless}}

{{/if}}
</section>
